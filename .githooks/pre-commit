#!/bin/sh
# Runs the fast quality checks before every commit. `npm run build` is left to
# the push/deploy step because it takes minutes. Skip in an emergency with
# `git commit --no-verify`.
set -e

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: tests"
npm test --silent
